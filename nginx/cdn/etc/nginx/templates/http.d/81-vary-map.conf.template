map "$NGINX_GZIP:$NGINX_GZIP_STATIC" $cdn_vary_accept_encoding {
  default "";
  ~on "Accept-Encoding";
}

map "$NGINX_AUTO_WEBP:$uri" $cdn_vary_accept {
  default "";
  ~*^on:.*\.(?:png|jpe?g)$ "Accept";
}

map "$cdn_vary_accept:$cdn_vary_accept_encoding" $cdn_vary {
  default "";
  "Accept:" "Accept";
  ":Accept-Encoding" "Accept-Encoding";
  "Accept:Accept-Encoding" "Accept, Accept-Encoding";
}
